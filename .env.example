# Local Postgres via Docker (see README): docker compose up -d
DATABASE_URL="postgresql://mailtostory:mailtostory_dev@localhost:5434/mailtostory?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GEMINI_API_KEY=""
# Google Analytics (optional; omit locally to skip tracking)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-P43B4NBGRL"
# Production on shared Hostinger VPS (with dt-wellness): use PORT=3010 and set NEXTAUTH_URL=https://mailtostory.com
# PORT=3010
# MAILTOSTORY_PORT=3010
# DATABASE_URL="postgresql://mailtostory:PASSWORD@localhost:5432/mailtostory?schema=public"
# Optional: first model to try (then built-in fallbacks). Omit to start with gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"
# Optional: comma-separated extra fallbacks after GEMINI_MODEL
# GEMINI_MODEL_FALLBACKS="gemini-2.5-flash-lite,gemini-2.0-flash-lite"
