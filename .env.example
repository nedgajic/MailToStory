# Local Postgres via Docker (see README): docker compose up -d
DATABASE_URL="postgresql://mailtostory:mailtostory_dev@localhost:5434/mailtostory?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GEMINI_API_KEY=""

# Postmark inbound
# POSTMARK_INBOUND_DOMAIN="inbox.mailtostory.com"
# POSTMARK_INBOUND_BASIC_USER="mailtostory"
# POSTMARK_INBOUND_BASIC_PASSWORD="long-random-secret"
# POSTMARK_WEBHOOK_TOKEN=""
# INBOUND_UPLOAD_DIR="./uploads"

# Attachment storage (optional Cloudflare R2 — falls back to local disk when unset)
# ATTACHMENT_STORAGE="auto"
# ATTACHMENT_STORAGE="local"
# ATTACHMENT_STORAGE="r2"
# R2_BUCKET=""
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PREFIX="attachments"

# Optional ClamAV daemon for attachment scanning (free if you run clamd locally)
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT="3310"

# Optional dedicated encryption key for stored TOTP secrets (defaults to NEXTAUTH_SECRET)
# TWO_FACTOR_ENCRYPTION_KEY=""

# Postmark outbound (verify, reset, invites, story-ready notifications)
# POSTMARK_SERVER_TOKEN=""
# POSTMARK_FROM_EMAIL="MailToStory <noreply@mailtostory.com>"

# Stripe
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_PRO_ANNUAL="price_..."
# STRIPE_PRICE_TEAM="price_..."
# STRIPE_PRICE_TEAM_ANNUAL="price_..."

# Optional backup keys (comma-separated)
# GEMINI_API_KEY_FALLBACKS=""
# GEMINI_MODEL="gemini-2.5-flash"
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# PORT=3010

# Abuse protection (defaults shown — omit to use built-in values)
# GENERATION_LIMIT_HOURLY=30
# GENERATION_LIMIT_DAILY=200
# GENERATION_LIMIT_PRO_MONTHLY=500
# GENERATION_LIMIT_TEAM_MONTHLY_PER_SEAT=500
# REGENERATION_DEBOUNCE_MINUTES=15
# INBOUND_REQUIRE_VERIFIED_EMAIL=true
# QUARANTINE_RETENTION_DAYS=14
# CRON_SECRET="generate-with-openssl-rand-base64-32"
# GENERATION_LOG_RETENTION_DAYS=90

# Admin (/admin storage metrics)
# ADMIN_EMAILS="nedgajic@gmail.com"

# Error monitoring (optional)
# SENTRY_DSN="https://...@sentry.io/..."

# Off-site backups (optional — see scripts/backup-*.sh)
# BACKUP_S3_BUCKET=""
# BACKUP_S3_ENDPOINT=""
# BACKUP_S3_ACCESS_KEY_ID=""
# BACKUP_S3_SECRET_ACCESS_KEY=""
# BACKUP_S3_PREFIX="mailtostory"
