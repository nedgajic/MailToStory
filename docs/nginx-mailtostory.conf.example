# Nginx site for mailtostory.com on the shared Hostinger VPS (dt-wellness on 5173).
# Install on server:
#   sudo cp docs/nginx-mailtostory.conf.example /etc/nginx/sites-available/mailtostory
#   sudo ln -sf /etc/nginx/sites-available/mailtostory /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d mailtostory.com -d www.mailtostory.com

upstream mailtostory_app {
    server 127.0.0.1:3010;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name mailtostory.com www.mailtostory.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mailtostory.com www.mailtostory.com;

    # After certbot, paths are usually under /etc/letsencrypt/live/mailtostory.com/
    # ssl_certificate /etc/letsencrypt/live/mailtostory.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mailtostory.com/privkey.pem;

    client_max_body_size 20m;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://mailtostory_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
    }
}
