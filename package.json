{
  "name": "mailtostory",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "doctor": "node scripts/preflight.mjs",
    "db:migrate": "node scripts/ensure-migrations.mjs",
    "postinstall": "prisma generate",
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "node scripts/ensure-migrations.mjs && NODE_OPTIONS='--disable-warning=DEP0108' next dev --webpack -p 3001",
    "build": "NODE_OPTIONS='--disable-warning=DEP0108' next build",
    "start": "NODE_OPTIONS='--disable-warning=DEP0108' next start",
    "deploy": "./deploy.sh",
    "deploy:dry-run": "./deploy.sh --dry-run",
    "deploy:bootstrap": "bash scripts/bootstrap-server.sh",
    "lint": "eslint",
    "test": "vitest run",
    "test:threads": "node scripts/send-test-threads.mjs",
    "ingest:threads": "tsx scripts/ingest-test-threads.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.71.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.6.1",
    "md5": "^2.3.0",
    "next": "^16.2.4",
    "next-auth": "^4.24.14",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.3",
    "stripe": "^22.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/md5": "^2.3.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
